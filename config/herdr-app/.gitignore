# ~/.config/herdr-app is symlinked to this directory, so herdr writes all of its
# runtime state (built-in mods, telemetry, sockets, window state, etc.) here.
# Ignore everything and explicitly allow the files we want to share.
/*
!/.gitignore

!/keys.json

!/layouts/
/layouts/*
!/layouts/my-main.json

!/mods/
/mods/*
!/mods/pull-requests/

!/themes/
/themes/*
!/themes/snazzy.json
